{
  "name": "sync",
  "scripts": {
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "biome check .",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm -w @sync/db run migrate",
    "db:test": "npm -w @sync/db run test-db",
    "db:agent": "npm -w @sync/db run agent --",
    "db:customer": "npm -w @sync/db run customer --",
    "test": "vitest run",
    "dev": "npm -w @sync/api run dev",
    "start": "npm -w @sync/api run start",
    "dev:site": "npm -w @sync/web-site run dev",
    "start:all": "npm run db:up && concurrently -k -n api,site,console,zap -c red,cyan,yellow,green \"npm run dev\" \"npm run dev:site\" \"npm run dev:admin\" \"npm run dev:zap\"",
    "dev:admin": "npm -w @sync/web-admin run dev",
    "dev:zap": "npm -w @sync/web-whatsapp run dev"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
