DATABASE_URL="mysql://root:sync@localhost:3307/sync"
PORT=3333
JWT_SECRET="troque-este-segredo-em-producao-com-32-chars"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"

# ---------- WhatsApp ----------
# mock = tela local com cara de WhatsApp, funciona offline
# meta = WhatsApp Business Cloud API de verdade
WHATSAPP_DRIVER="mock"

# Copiados do painel do app em developers.facebook.com > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
# O numero de teste, so digitos, para montar o link wa.me
WHATSAPP_FROM_NUMBER=""

# Copiado de Configuracoes do app > Basico > Chave secreta do aplicativo.
# Serve para validar a assinatura X-Hub-Signature-256: sem isso qualquer um
# posta no webhook uma mensagem falsa fingindo ser um cliente.
WHATSAPP_APP_SECRET=""

# Inventado por voce. A Meta devolve este mesmo valor no desafio de verificacao
# do webhook, e so serve para provar que o endereco e seu.
WHATSAPP_VERIFY_TOKEN=""
